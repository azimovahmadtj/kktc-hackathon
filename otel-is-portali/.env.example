# Copy this file to .env and fill in the values.

# Database: leave empty to use SQLite (built into Python, nothing to install).
# For PostgreSQL uncomment and edit:
# DATABASE_URL=postgres://otelportal:otelportal@127.0.0.1:5432/otelportal
DATABASE_URL=

# Claude API key for AI CV matching (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Optional: model to use (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5

# Django
DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
